APP_ENV=development

# Display name of the assistant. Changing this renames it everywhere.
APP_NAME=Assistant
OWNER_NAME=

OPENAI_API_KEY=
# Defaults to gpt-5.4-mini when empty.
OPENAI_MODEL=

# Local PostgreSQL started with `docker compose up postgres`.
# docker-compose.yml overrides this for the backend container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_ai

# Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Browser origins allowed to call the API (the web dashboard).
CORS_ORIGINS=["http://localhost:3000"]

# When set, device agents must send this token to connect to /ws/devices.
AGENT_TOKEN=

# Voice (OpenAI Realtime). Audio is billed per minute. The full model understands and
# speaks Azerbaijani much better; gpt-realtime-2.1-mini is ~3x cheaper.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
VOICE_LANGUAGE=az

# Obsidian vault used as long-term memory (outside Docker; compose uses OBSIDIAN_VAULT in ../.env).
OBSIDIAN_VAULT_PATH=

# true: shell, Terminal and AppleScript run without asking. Commands that look destructive
# (rm, sudo, force push, ...) still wait for a confirm.
FULL_AUTONOMY=false

# Native Azerbaijani voice (Azure Speech, free tier: 500k characters/month). Without a key,
# the realtime model speaks itself, with a foreign accent.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# az-AZ-BabekNeural (male) or az-AZ-BanuNeural (female)
AZURE_TTS_VOICE=az-AZ-BabekNeural

# "friend": talk like a close friend - slang and swearing. "default": warm and polite.
ASSISTANT_STYLE=default
