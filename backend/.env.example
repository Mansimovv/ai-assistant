APP_ENV=development

# Display name of the assistant. Changing this renames it everywhere.
APP_NAME=Assistant

OPENAI_API_KEY=
# Defaults to gpt-5.4-mini when empty.
OPENAI_MODEL=

# Local PostgreSQL started with `docker compose up postgres`.
# docker-compose.yml overrides this for the backend container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_ai

# Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Browser origins allowed to call the API (the web dashboard).
CORS_ORIGINS=["http://localhost:3000"]

# When set, device agents must send this token to connect to /ws/devices.
AGENT_TOKEN=

# Voice (OpenAI Realtime). Audio is billed per minute; the mini model is ~3x cheaper.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
VOICE_LANGUAGE=az
